{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Naza Couture site content",
  "type": "object",
  "required": [
    "schema_version",
    "brand",
    "public_url",
    "timezone",
    "address",
    "contact",
    "opening_hours",
    "navigation",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "public_url": {
      "type": "string",
      "format": "uri"
    },
    "timezone": {
      "const": "Europe/Paris"
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "tagline"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tagline": {
          "$ref": "#/$defs/bilingual"
        }
      },
      "additionalProperties": true
    },
    "address": {
      "type": "object",
      "required": [
        "street",
        "postal_code",
        "city",
        "country",
        "display"
      ],
      "properties": {
        "street": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "display": {
          "$ref": "#/$defs/bilingual"
        }
      },
      "additionalProperties": true
    },
    "contact": {
      "type": "object",
      "required": [
        "phone_display",
        "phone_e164",
        "email",
        "social"
      ],
      "properties": {
        "phone_display": {
          "type": "string"
        },
        "phone_e164": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "social": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": true
    },
    "opening_hours": {
      "type": "object",
      "required": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "properties": {
        "monday": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "open",
                "close"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "tuesday": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "open",
                "close"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "wednesday": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "open",
                "close"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "thursday": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "open",
                "close"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "friday": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "open",
                "close"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "saturday": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "open",
                "close"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "sunday": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "open",
                "close"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "close": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "navigation": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/bilingual"
      }
    },
    "pages": {
      "type": "object"
    },
    "announcements": {
      "type": "array"
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": [
        "fr",
        "uk"
      ],
      "properties": {
        "fr": {
          "type": [
            "string",
            "null"
          ]
        },
        "uk": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}