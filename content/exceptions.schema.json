{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Naza Couture schedule exceptions",
  "type": "object",
  "required": ["schema_version", "exceptions"],
  "properties": {
    "schema_version": { "const": 2 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "start_date", "end_date", "label", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "type": { "enum": ["hours", "closed"] },
          "reason": { "enum": ["holiday", "vacation", "other"] },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "hours": {
            "type": "object",
            "required": ["open", "close"],
            "properties": {
              "open": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "close": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
            },
            "additionalProperties": false
          },
          "label": { "$ref": "#/$defs/bilingualText" },
          "description": { "$ref": "#/$defs/bilingualNullableText" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "hours" } }, "required": ["type"] },
            "then": { "required": ["hours"], "not": { "required": ["reason"] } }
          },
          {
            "if": { "properties": { "type": { "const": "closed" } }, "required": ["type"] },
            "then": { "required": ["reason"], "not": { "required": ["hours"] } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "bilingualText": {
      "type": "object",
      "required": ["fr", "uk"],
      "properties": {
        "fr": { "type": "string", "minLength": 1 },
        "uk": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "bilingualNullableText": {
      "type": "object",
      "required": ["fr", "uk"],
      "properties": {
        "fr": { "type": ["string", "null"] },
        "uk": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
